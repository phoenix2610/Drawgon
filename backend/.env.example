NODE_ENV=development
PORT=3000

# Local Docker Postgres (docker-compose.yml):
#   postgresql://ccwp:ccwp_dev_password@localhost:5432/ccwp
#
# Supabase — Project Settings > Database > Connection string > URI.
# Use the SESSION POOLER (port 5432), not the transaction pooler (6543):
# TypeORM migrations run DDL and both TypeORM and better-auth use prepared
# statements, which PgBouncer's transaction mode does not support.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SSL is applied automatically for any non-localhost host.
DATABASE_URL=postgresql://ccwp:ccwp_dev_password@localhost:5432/ccwp

BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

FRONTEND_URL=http://localhost:5173
